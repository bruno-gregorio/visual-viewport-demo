{
  "name": "react-vv",
  "version": "0.0.0",
  "description": "Tiny React hooks around the Visual Viewport API — track the visual viewport size and expose it as CSS variables.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "visual-viewport",
    "viewport",
    "keyboard",
    "mobile",
    "dvh",
    "hooks"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "typescript": "^6.0.3"
  }
}
