{
  "name": "visual-viewport-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter visual-viewport-demo dev",
    "build": "bun run build:lib && bun run build:demo",
    "build:lib": "bun run --filter react-vv build",
    "build:demo": "bun run --filter visual-viewport-demo build",
    "preview": "bun run --filter visual-viewport-demo preview",
    "lint": "biome check .",
    "format": "biome format --write .",
    "deploy": "./scripts/deploy-gh-pages.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15"
  }
}
